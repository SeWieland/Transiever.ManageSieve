<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Transiever.ManageSieve</Title>
    <Description>Async .NET 10 client library for RFC 5804 ManageSieve and secure server-side Sieve script operations.</Description>
    <PackageTags>transiever;managesieve;rfc5804;sieve;email-filtering;mail-filtering;dotnet;csharp;tls;sasl</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://sewieland.github.io/transiever/dotnet-managesieve-client/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SeWieland/Transiever.ManageSieve</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
