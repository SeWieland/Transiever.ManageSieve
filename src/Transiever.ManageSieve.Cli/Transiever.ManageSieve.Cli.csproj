<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>msieve</AssemblyName>
    <RootNamespace>Transiever.ManageSieve.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>msieve</ToolCommandName>
    <PackageId>Transiever.ManageSieve.Cli</PackageId>
    <Description>Cross-platform .NET CLI and global tool for RFC 5804 ManageSieve and server-side Sieve scripts.</Description>
    <PackageTags>transiever;managesieve;rfc5804;sieve;email-filtering;mail-filtering;dotnet;csharp;cli;tool;dotnet-tool</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://sewieland.github.io/transiever/managesieve-cli/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SeWieland/Transiever.ManageSieve</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Transiever.ManageSieve\Transiever.ManageSieve.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
